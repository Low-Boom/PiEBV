# KiCad: per-project local history (KiCad's own git repo) and open-file lock files
.history/
*.lck

# Backups: KiCad MCP server snapshots, KiCad's own project backups / autosaves, editor backups
.mcp-backups/
*-backups/
_autosave-*
*-bak
*.bak
# JLC CPL rotation tool (tools/jlc_cpl): downloaded footprints and intermediate files
tools/jlc_cpl/eda/
tools/jlc_cpl/kpads.json
tools/jlc_cpl/cpl_new.csv
# KiCad check reports (regenerate with kicad-cli; not kept in the repo)
erc.json
*_drc_violations.json
# KiCad per-user view settings (layer visibility, open files)
*.kicad_prl
# EuroCard re-layout (tools/eurocard): router clone, its Python venv, run files
tools/eurocard/KiCadRoutingTools/
tools/eurocard/.venv/
tools/eurocard/work/
tools/rev2/work/
